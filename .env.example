# Flip to false once real (Supabase) service implementations exist.
EXPO_PUBLIC_USE_MOCKS=true

# Optional: center point for seeded mock users (defaults to San Francisco).
# EXPO_PUBLIC_MOCK_CENTER_LAT=37.7749
# EXPO_PUBLIC_MOCK_CENTER_LNG=-122.4194
# EXPO_PUBLIC_MOCK_CENTER_CITY=San Francisco

# Supabase (real backend). Put the real values in .env.local, which is git-ignored.
# EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...   (publishable key only; NEVER the service-role/secret key)
